# Optional environment variables for solana-token-safety.
# Copy to .env and fill in only what your environment needs.
# No API key is required for any data source used by this server.

# Serve Streamable HTTP on 0.0.0.0:$PORT instead of stdio.
# Set this when running in a container host (MCPize, MCPRush, etc.).
# Leave unset for local stdio use.
# PORT=8080

# Egress proxy, only if your network blocks direct outbound HTTPS.
# The server reads these explicitly (trust_env=False).
# HTTPS_PROXY=
# HTTP_PROXY=
# ALL_PROXY=

# Extra CA bundle, only if your proxy intercepts TLS with its own CA.
# SSL_CERT_FILE=
# REQUESTS_CA_BUNDLE=
